{
    "name": "cartes.gouv.fr-documentation",
    "version": "1.0.0",
    "description": "Site statique de documentation pour cartes.gouv.fr",
    "scripts": {
        "build": "npx @11ty/eleventy",
        "postbuild": "npx pagefind --site _site/ --output-subdir \"_pagefind\"",
        "start": "npx @11ty/eleventy --serve --quiet --pathprefix=/aide",
        "prestart": "npm run build",
        "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
        "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
        "benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
        "format:prettier": "prettier --check .",
        "format:prettier:fix": "prettier --write .",
        "prepare": "husky"
    },
    "repository": {
        "type": "git",
        "url": "git@github.com:IGNF/cartes.gouv.fr-documentation.git"
    },
    "author": {
        "name": "Institut national de l'information géographique et forestière (IGN)",
        "email": "geoplateforme@ign.fr",
        "url": "https://www.ign.fr"
    },
    "license": "MIT",
    "engines": {
        "node": ">=24.15.0"
    },
    "devDependencies": {
        "@11ty/eleventy": "^3.1.7",
        "@11ty/eleventy-img": "^6.0.4",
        "@11ty/eleventy-navigation": "^1.0.5",
        "@11ty/eleventy-plugin-bundle": "^4.0.3",
        "@11ty/eleventy-plugin-rss": "^3.1.0",
        "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
        "@gouvfr/dsfr": "^1.15.4",
        "@prettier/plugin-xml": "^3.4.2",
        "chalk": "^6.0.1",
        "husky": "^9.1.7",
        "ics": "^3.12.1",
        "lint-staged": "^17.6.0",
        "luxon": "^3.7.2",
        "markdown-it-anchor": "^10.0.0",
        "markdown-it-attrs": "^5.0.1",
        "markdown-it-container": "^4.0.0",
        "mermaid": "^12.2.0",
        "pagefind": "^1.5.2",
        "prettier": "^3.9.10"
    },
    "dependencies": {
        "@codegouvfr/eleventy-plugin-calendar": "^3.0.6",
        "@codegouvfr/eleventy-plugin-i18n": "^0.1.3",
        "jsdom": "^30.1.3",
        "keycloak-js": "^26.2.4",
        "swagger-ui": "^5.34.0"
    },
    "lint-staged": {
        "*.{js,ts,json,css,scss,xml,yml,yaml,html}": [
            "prettier --write"
        ]
    },
    "allowScripts": {
        "@gouvfr/dsfr@1.15.4": true
    }
}
